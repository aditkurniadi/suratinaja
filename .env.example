APP_NAME=SuratinAja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suratinaja
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@suratinaja.local"
MAIL_FROM_NAME="${APP_NAME}"

GOTENBERG_URL=http://gotenberg:3000
ONLYOFFICE_URL=http://127.0.0.1:8082
ONLYOFFICE_INTERNAL_URL=http://onlyoffice:80
ONLYOFFICE_JWT_SECRET=suratinaja-onlyoffice-secret-key-12345
ONLYOFFICE_PORT=8082
SUPERADMIN_EMAIL=superadmin@suratinaja.test
SUPERADMIN_PASSWORD=password

# Access Control (Invite-Only by default)
ALLOW_PUBLIC_REGISTRATION=false

# Read-Only Demo Mode
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=demo@suratinaja.test
DEMO_USER_PASSWORD=DemoSuratinAja2026!
DEMO_WORKSPACE_NAME="Himpunan Mahasiswa Demo"

VITE_APP_NAME="${APP_NAME}"
