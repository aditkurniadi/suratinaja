# ==============================================================================
# SuratinAja — Konfigurasi Lingkungan Production
# ==============================================================================
# Salin file ini menjadi .env di server production:
# cp .env.production.example .env

APP_NAME=SuratinAja
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://surat.himatris.org

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================================
# Database Configuration (MySQL 8.0)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=suratinaja
DB_USERNAME=suratinaja_user
DB_PASSWORD=GantiDenganPasswordDatabaseSangatKuat123!
DOCKER_DB_ROOT_PASSWORD=GantiDenganRootPasswordDatabaseSangatKuat123!

# ==============================================================================
# Queue & Session & Cache (Database Driver)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# PDF Preview Microservice (Gotenberg 8)
# ==============================================================================
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=60

# ==============================================================================
# SuratinAja Initial Super Admin Credentials
# Akun ini otomatis dibuat saat pertama kali menjalankan database seeder.
# ==============================================================================
SUPERADMIN_EMAIL=admin@himatris.org
SUPERADMIN_PASSWORD=GantiDenganPasswordAdminSangatKuat123!

# ==============================================================================
# Batasan Upload & Retensi
# ==============================================================================
SURATINAJA_TEMPLATE_MAX_KB=51200
SURATINAJA_LOGO_MAX_KB=2048
SURATINAJA_BULK_MAX=500
SURATINAJA_DATE_FORMAT="d F Y"
