# ==============================================================================
# SuratinAja — Dokploy Environment Configuration
# ==============================================================================
# Salin seluruh variabel di bawah ini ke tab "Environment" service Dokploy Anda.

# --- Identitas & Keamanan Aplikasi ---
APP_NAME=SuratinAja
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:W/TlrCnt0sjCx83rG1bDQqjbSCNAnq2b/Ex7Cpu5qik=
APP_URL=https://surat.domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=172.17.0.1
DB_PORT=3306
DB_DATABASE=suratinaja
DB_USERNAME=root
DB_PASSWORD=GantiDenganPasswordDatabaseAnda

# --- Queue, Session, & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Gotenberg (PDF Preview Service) ---
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=60

# --- OnlyOffice Document Server ---
# ONLYOFFICE_URL: Domain publik yang dibuka di browser (atur routing domain ini ke service onlyoffice port 80 di Dokploy)
ONLYOFFICE_URL=https://office.domainanda.com

# ONLYOFFICE_INTERNAL_URL: URL komunikasi internal container Docker
ONLYOFFICE_INTERNAL_URL=http://onlyoffice:80

# ONLYOFFICE_JWT_SECRET: Kunci rahasia token JWT yang sama antara Laravel dan Dokploy
ONLYOFFICE_JWT_SECRET=GantiDenganSecretAcakMin32KarakterHeksadesimal12345

# --- QPDF (PDF Merger CLI) ---
QPDF_BINARY=/usr/bin/qpdf

# --- Initial Superadmin Credentials (Opsional saat Seed) ---
SUPERADMIN_EMAIL=admin@domainanda.com
SUPERADMIN_PASSWORD=GantiPasswordSuperAdminAman123!
